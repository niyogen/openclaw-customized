{
  "containerDefinitions": [
    {
      "name": "openclaw-backend",
      "image": "582604091763.dkr.ecr.us-east-1.amazonaws.com/openclaw-backend:v3",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SUBDOMAIN",
          "value": "testcorpwa"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://postgres:SuperSecretPassword123@openclaw-saas-db.cmt466aga8u0.us-east-1.rds.amazonaws.com:5432/postgres"
        },
        {
          "name": "CUSTOMER_NAME",
          "value": "TestCorpWA"
        },
        {
          "name": "ENVIRONMENT",
          "value": "production"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "/openclaw/customers/testcorpwa/OPENAI_API_KEY"
        }
      ],
      "systemControls": []
    }
  ],
  "family": "tenant-testcorpwa-task",
  "executionRoleArn": "arn:aws:iam::582604091763:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
